# Copy to .env and fill in. Never commit .env.
# Personal API key from cloud.sandscale.dev (account settings). Starts with nia_.
# It is shown once and expires within 90 days. Give it the sandboxes:create and sandboxes:use permissions.
SANDSCALE_API_KEY=nia_replace_me

# Optional. Defaults to https://api.sandscale.dev, which routes to your region (United States today).
# SANDSCALE_BASE_URL=https://api.sandscale.dev
